{
  "timezone": "Asia/Shanghai",
  "database_path": "data/app.db",
  "log_path": "logs/app.log",
  "poll_interval": 1.0,
  "schedule_poll_seconds": 5.0,
  "send_verify": true,
  "duplicate_window_hours": 24,
  "delivery_timeout_seconds": 30,
  "napcat": {
    "enabled": false,
    "websocket_url": "ws://127.0.0.1:3001",
    "access_token": "",
    "reconnect_seconds": 5,
    "request_timeout_seconds": 30
  },
  "ai": {
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-5-mini",
    "api_key_env": "AI_API_KEY",
    "timeout_seconds": 60,
    "temperature": 0.1,
    "max_steps": 10,
    "verify_ssl": true,
    "log_requests": false,
    "thinking_enabled": false,
    "reasoning_effort": "low",
    "retry_attempts": 2
  },
  "defaults": {
    "history_limit": 30,
    "aggregation_seconds": 8,
    "importance_threshold": 70
  },
  "groups": [
    {
      "id": "需要监听的群名或群聊内部标识",
      "name": "项目讨论群",
      "forward_to": [
        "文件传输助手"
      ],
      "system_prompt_file": "prompts/project_group.md",
      "enabled": true,
      "chain": {
        "enabled": false,
        "review_history": false,
        "rules": [
          {
            "name": "宿舍晚点名",
            "enabled": true,
            "prompt": "只参加标题包含‘宿舍晚点名’的接龙。按照群里已有条目的格式填写本人宿舍和状态；如果历史中已有本人姓名或相同内容，则不要重复参加。",
            "match_keywords": ["晚点名", "宿舍"],
            "exclude_keywords": ["无需接龙"],
            "entry_template": "{{profile.dormitory}} {{profile.name}}已返校",
            "self_identifiers": ["{{profile.name}}"]
          }
        ]
      }
    }
  ]
}
